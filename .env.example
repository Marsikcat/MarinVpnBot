# Шаблон настроек: скопируйте в .env и заполните.
# После правки .env — перезапуск бота. Тарифы, триал, ссылки и реквизиты СБП
# удобнее менять прямо в боте: /settings и /plans (значения отсюда — по умолчанию).

# --- Telegram ---
BOT_TOKEN=                              # токен от @BotFather
ADMIN_IDS=                              # ваш Telegram ID (узнать: /id в боте); несколько — через запятую
SUPPORT_URL=https://t.me/your_support
CHANNEL_URL=
REQUIRED_CHANNEL_ID=                    # @канал или -100…, если триал только для подписчиков

# --- База данных ---
DATABASE_URL=sqlite+aiosqlite:///./data/vpnbot.db

# --- VPN-панель: mock | marzban | xui ---
VPN_PROVIDER=mock

MARZBAN_URL=https://panel.example.com
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=changeme
MARZBAN_PROXIES=vless
MARZBAN_INBOUNDS=
MARZBAN_SUB_DOMAIN=

XUI_URL=https://panel.example.com:2053/secret_path   # без /panel в конце
XUI_USERNAME=admin
XUI_PASSWORD=changeme
XUI_INBOUND_IDS=                        # пусто = все inbound'ы панели
XUI_SUB_BASE=https://panel.example.com:2096/sub

# --- Пробный период и трафик (0 = безлимит) ---
TRIAL_ENABLED=true
TRIAL_DAYS=3
TRIAL_TRAFFIC_GB=10
DEFAULT_TRAFFIC_GB=0

# --- Оплата ---
PAY_STARS_ENABLED=true
STARS_RUB_RATE=1.6

PAY_SBP_ENABLED=false
SBP_PHONE=
SBP_BANK=
SBP_RECEIVER=

PAY_YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/your_bot

PAY_CRYPTOBOT_ENABLED=false
CRYPTOBOT_TOKEN=
CRYPTOBOT_ASSET=USDT
USD_RUB_RATE=95

# --- Вебхуки платёжек (без них оплаты подтверждаются опросом раз в 3 минуты) ---
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_SECRET=change-me

# --- Прочее ---
LOG_LEVEL=INFO
TZ=Europe/Moscow
